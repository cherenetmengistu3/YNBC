# Port number for the Express server to listen on
PORT=3000
# Environment mode (development, production, etc.)
NODE_ENV=development

# Hostname of the MySQL database server
DB_HOST=localhost
# Username for the MySQL database
DB_USER=root
# Password for the MySQL database
DB_PASSWORD=Henok@1995
# Name of the database to connect to
DB_NAME=expense_iq_db
# Port number for the MySQL database server
DB_PORT=3306

# Origins allowed by the CORS middleware
CORS_ORIGIN=*

# Secret key used to sign and verify JSON Web Tokens
JWT_SECRET=your_super_secret_jwt_key_12345
# Duration for which a generated JWT remains valid
JWT_EXPIRES_IN=24h
