<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.microsoft.com/tools">
    <!-- Base application theme -->
    <style name="Theme.YNBA" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>

        <!-- Secondary brand color -->
        <item name="colorSecondary">@color/accent</item>
        <item name="colorSecondaryVariant">@color/accent</item>
        <item name="colorOnSecondary">@color/white</item>

        <!-- Status bar color (minSdk 24, so tools:targetApi is not needed) -->
        <item name="android:statusBarColor">@color/primary_dark</item>

        <!-- UI Elements -->
        <item name="android:windowBackground">@color/window_bg</item>
        <item name="cardBackgroundColor">@color/card_bg</item>
    </style>
</resources>